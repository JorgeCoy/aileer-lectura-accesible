rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auxiliar: ¿El usuario inició sesión?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Auxiliar: ¿Es el propio usuario?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Auxiliar: Obtener el documento de usuario de Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Auxiliar: Obtener el rol del usuario
    function getUserRole() {
      return getUserData().role;
    }

    // Auxiliar: Obtener el colegio (schoolId) del usuario
    function getUserSchoolId() {
      return getUserData().schoolId;
    }

    // Colección de Usuarios (/users)
    match /users/{userId} {
      // Lectura: El propio usuario o miembros del mismo colegio
      allow read: if isOwner(userId) || (isAuthenticated() && resource.data.schoolId == getUserSchoolId());
      
      // Creación: Todo registro público nace como 'student' (previene auto-elevación de rol/colegio)
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      
      // Edición: El usuario NO PUEDE alterar su propio 'role' ni su 'schoolId' (imposibilita la auto-escalación)
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role 
        && (!('schoolId' in resource.data) || request.resource.data.schoolId == resource.data.schoolId);
    }

    // Colección de Clases (/classes)
    match /classes/{classId} {
      // Lectura: Solo usuarios del mismo colegio o el docente dueño de la clase
      allow read: if isAuthenticated() && (resource.data.schoolId == getUserSchoolId() || resource.data.teacherId == request.auth.uid);
      
      // Creación: Solo docentes autenticados vinculando su propio teacherId
      allow create: if isAuthenticated() && getUserRole() == 'teacher' && request.resource.data.teacherId == request.auth.uid;
      
      // Edición y Eliminación: Solo el docente dueño de la clase
      allow update, delete: if isAuthenticated() && getUserRole() == 'teacher' && resource.data.teacherId == request.auth.uid;
    }

    // Colección de Tareas / Asignaciones (/assignments)
    match /assignments/{assignmentId} {
      // Lectura: Docente dueño o usuarios del mismo colegio
      allow read: if isAuthenticated() && (resource.data.teacherId == request.auth.uid || resource.data.schoolId == getUserSchoolId());
      
      // Creación: Solo docentes autenticados asignándose como creadores
      allow create: if isAuthenticated() && getUserRole() == 'teacher' && request.resource.data.teacherId == request.auth.uid;
      
      // Edición y Eliminación: Solo el docente dueño
      allow update, delete: if isAuthenticated() && getUserRole() == 'teacher' && resource.data.teacherId == request.auth.uid;
    }

    // Colección de Progreso y Lecturas (/progress)
    match /progress/{progressId} {
      // Lectura: El propio estudiante O docentes del MISMO colegio (aislamiento total multi-tenant)
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        (getUserRole() == 'teacher' && resource.data.schoolId == getUserSchoolId())
      );
      
      // Creación y Edición: Estricto. El estudiante solo puede escribir SU propio progreso en SU propio colegio
      allow create, update: if isAuthenticated() 
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.schoolId == getUserSchoolId();
    }

    // Colección de Sesiones de Diagnóstico (PIN Exprés de 3 Minutos)
    match /diagnostic_sessions/{sessionId} {
      // Creación: Solo docentes autenticados pueden iniciar sesiones
      allow create: if isAuthenticated() && getUserRole() == 'teacher' && request.resource.data.teacherId == request.auth.uid;
      
      // Lectura: Docente dueño o estudiantes participando en sesión activa
      allow read: if (isAuthenticated() && resource.data.teacherId == request.auth.uid) || resource.data.status == 'active';
      
      // Edición: Solo permite añadir resultados a la sesión activa sin sobreescribir PIN, docente ni título
      allow update: if resource.data.status == 'active'
        && request.resource.data.pin == resource.data.pin
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.sessionTitle == resource.data.sessionTitle;
    }

    // Bloqueo estricto por defecto para cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
