rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auxiliar: ¿El usuario inició sesión?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Auxiliar: ¿Es el propio usuario?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Auxiliar: Obtener el documento de usuario de Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Auxiliar: Obtener el rol del usuario
    function getUserRole() {
      return getUserData().role;
    }

    // Auxiliar: Obtener el colegio (schoolId) del usuario
    function getUserSchoolId() {
      return getUserData().schoolId;
    }

    // Colección de Usuarios (/users)
    match /users/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && resource.data.schoolId == getUserSchoolId());
      allow create: if isOwner(userId) 
        && request.resource.data.role == 'student' 
        && (!('schoolId' in request.resource.data) || request.resource.data.schoolId == null);
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role 
        && (!('schoolId' in resource.data) || request.resource.data.schoolId == resource.data.schoolId);
    }

    // Colección de Clases (/classes)
    match /classes/{classId} {
      allow read: if isAuthenticated() && (resource.data.schoolId == getUserSchoolId() || resource.data.teacherId == request.auth.uid);
      allow create: if isAuthenticated() 
        && getUserRole() == 'teacher' 
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.schoolId == getUserSchoolId();
      
      // Inmutabilidad de schoolId y teacherId en edición de clases
      allow update: if isAuthenticated() 
        && getUserRole() == 'teacher' 
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.teacherId == resource.data.teacherId;

      allow delete: if isAuthenticated() && getUserRole() == 'teacher' && resource.data.teacherId == request.auth.uid;
    }

    // Colección de Tareas / Asignaciones (/assignments)
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (resource.data.teacherId == request.auth.uid || resource.data.schoolId == getUserSchoolId());
      allow create: if isAuthenticated() 
        && getUserRole() == 'teacher' 
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.schoolId == getUserSchoolId();
      
      // Inmutabilidad de schoolId y teacherId en edición de asignaciones
      allow update: if isAuthenticated() 
        && getUserRole() == 'teacher' 
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.teacherId == resource.data.teacherId;

      allow delete: if isAuthenticated() && getUserRole() == 'teacher' && resource.data.teacherId == request.auth.uid;
    }

    // Colección de Progreso y Lecturas (/progress)
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        (getUserRole() == 'teacher' && resource.data.schoolId == getUserSchoolId())
      );
      allow create, update: if isAuthenticated() 
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.schoolId == getUserSchoolId();
    }

    // Colección de Sesiones de Diagnóstico (PIN Exprés de 3 Minutos)
    match /diagnostic_sessions/{sessionId} {
      allow create: if isAuthenticated() && getUserRole() == 'teacher' && request.resource.data.teacherId == request.auth.uid;
      
      // Obtener un documento individual sabiendo el PIN activo (El PIN es el Document ID)
      allow get: if isAuthenticated() && ((getUserRole() == 'teacher' && resource.data.teacherId == request.auth.uid) || resource.data.status == 'active');
      
      // Listado masivo (Query): Solo el docente creador
      allow list: if isAuthenticated() && getUserRole() == 'teacher' && resource.data.teacherId == request.auth.uid;
      
      // Edición / Cierre de Sesión: Solo el docente creador
      allow update: if isAuthenticated() && getUserRole() == 'teacher'
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
      
      // Subcolección independiente de envíos
      match /submissions/{submissionId} {
        allow create: if isAuthenticated() 
          && request.resource.data.studentUid == request.auth.uid
          && get(/databases/$(database)/documents/diagnostic_sessions/$(sessionId)).data.status == 'active';
        
        allow read: if isAuthenticated() && (
          resource.data.studentUid == request.auth.uid ||
          get(/databases/$(database)/documents/diagnostic_sessions/$(sessionId)).data.teacherId == request.auth.uid
        );
      }
    }

    // Bloqueo estricto por defecto para cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
